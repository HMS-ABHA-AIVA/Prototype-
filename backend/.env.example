PORT=5000
NODE_ENV=development
# The staff app's origin; several may be given, separated by commas (e.g. localhost and a Wi-Fi address)
FRONTEND_URL=http://localhost:5180
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/hms

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FACILITY_ACCESS_TOKEN_SECRET=
FACILITY_REFRESH_TOKEN_SECRET=
USER_ACCESS_TOKEN_SECRET=
USER_REFRESH_TOKEN_SECRET=

# 32-byte key (64 hex chars) used to encrypt ABDM client secrets at rest (AES-256-GCM)
ABDM_ENCRYPTION_KEY=

# ABDM gateway session endpoints
SANDBOX_SESSION_URL=https://dev.abdm.gov.in/api/hiecm/gateway/v3/sessions
PROD_SESSION_URL=https://live.abdm.gov.in/api/hiecm/gateway/v3/sessions

# Set true while running NHA sandbox test cases to log request metadata
# (REQUEST-ID, TIMESTAMP, X-CM-ID, URL, status) as evidence. Never logs bodies or tokens.
ABDM_AUDIT_LOG=false

# ---- Optional (defaults shown) ------------------------------------------------------------------------------
# ABDM HIE-CM gateway (Scan & Share callbacks and replies)
# SANDBOX_GATEWAY_URL=https://dev.abdm.gov.in/api/hiecm
# PROD_GATEWAY_URL=https://live.abdm.gov.in/api/hiecm
# Host printed in counter QR codes for Scan & Share
# SHARE_QR_SANDBOX_URL=https://phrsbx.abdm.gov.in/share-profile
# SHARE_QR_PRODUCTION_URL=https://phr.abdm.gov.in/share-profile

# ---- Hospital modules (/api/v1: OPD, IPD, pharmacy, lab, billing, staff ...) — all optional ------------------
# The platform console (/api/v1/platform): sets hospitals up and switches them off. Created once at start-up from these
# two values when no platform administrator of that name exists yet (the password must be strong).
# PLATFORM_ADMIN_USERNAME=platform
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_TOKEN_HOURS=8
# The consultation assistant and discharge drafts. With no key the screens still work, without AI suggestions.
# Patient identity is never sent to the AI service. Claude is used when both keys are set unless AI_PROVIDER=gemini.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AI_PROVIDER=anthropic
# AI_MODEL=claude-sonnet-5-5            (gemini-3.5-flash for Gemini)
# AI_API_URL=                           (the provider's own address by default)
# AI_REASONING_EFFORT=low
# AI_PAID_TIER=false                    (Gemini's free tier may use prompts for training: the app marks it demo-only)
# Attached documents and radiology images: local (FILE_STORE_DIR on disk), memory (tests) or none (uploads switched off).
# The default (auto) is none in production, until a persistent store is chosen; local otherwise.
# FILE_STORE=auto
# FILE_STORE_DIR=./data/files
# One-time codes and messages: simulator (an outbox the administrator can read) until an SMS gateway is connected.
# SMS_PROVIDER=simulator
# International drug names from the US National Library of Medicine (RxNorm), on top of the bundled Indian brand list.
# DRUG_ONLINE_LOOKUP=true
# RXNAV_URL=https://rxnav.nlm.nih.gov
# CLINICAL_TABLES_URL=https://clinicaltables.nlm.nih.gov
# Connections the hospital modules keep open to the database (Prisma keeps its own).
# HOSPITAL_DB_POOL_MAX=10
# PRISMA_POOL_MAX=10
# LOG_LEVEL=info
# Rate limits on sign-in and the API. Can be switched off only outside production (load tests, the test suite).
# RATE_LIMIT_ENABLED=true

# ---- Local development only ---------------------------------------------------------------------------------
# Accept any bearer token on the ABDM callback (for scripts/local_gateway.ts). Ignored when NODE_ENV=production.
# ABDM_SKIP_CALLBACK_JWT=true
# scripts/local_gateway.ts: where the backend runs
# BACKEND_URL=http://localhost:5000
# scripts/seed_demo.ts: demo facility and staff logins (refuses to run when NODE_ENV=production)
# SEED_FACILITY_EMAIL=
# SEED_STAFF_EMAIL=
# SEED_PASSWORD=
